#!/bin/sh
# CLAUDE.md, *Git*: a commit message ends at its own last line, with no Co-Authored-By or
# generated-with trailer. Tracked so a fresh clone gets it; `postinstall` points core.hooksPath here.
if grep -qiE '^(co-authored-by:|generated with )' "$1"; then
  echo "commit-msg: CLAUDE.md forbids Co-Authored-By and \"Generated with\" trailers." >&2
  exit 1
fi
exit 0
