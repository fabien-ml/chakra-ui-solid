# Read-only reference checkouts for the port (chakra-ui, ark-ui, zag, zag-v2). Never committed.
__reference-impl__/

# Dependencies
node_modules/

# Build output
dist/
.turbo/
*.tsbuildinfo
storybook-static/

# Panda CSS generated artifacts (`panda codegen`/`cssgen` → outdir). Regenerated by the
# `codegen` Turbo task and by postinstall, so they are never committed. Written as a nested
# path on purpose: the *package* `packages/styled-system/` stays tracked, only the
# `styled-system/` directory Panda writes inside it is ignored.
packages/*/styled-system/
apps/*/styled-system/

# TanStack Start / Nitro / Vite build artifacts (apps/docs)
.output/
.tanstack/
.nitro/

# Test artifacts
coverage/
test-results/
playwright-report/
.vitest-attachments/
**/__screenshots__/

# Env
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.localized
__MACOSX/
*.log
