# Read-only reference checkouts for the port (chakra-ui, ark-ui, zag, zag-v2). Never committed.
__reference-impl__/

# Dependencies
node_modules/

# Build output
dist/
.turbo/
*.tsbuildinfo
storybook-static/

# Panda CSS generated artifacts (`panda codegen`/`cssgen` → outdir). Regenerated by the
# `codegen` Turbo task and by postinstall, so they are never committed. Written as a nested
# path on purpose: the *package* `packages/styled-system/` stays tracked, only the
# `styled-system/` directory Panda writes inside it is ignored.
packages/*/styled-system/
apps/*/styled-system/

# TanStack Start / Nitro / Vite build artifacts (apps/docs)
.output/
.tanstack/
.nitro/
apps/docs/src/routeTree.gen.ts

# The docs site's generated props tables — read out of `packages/chakra-ui-solid/src/components` by
# `scripts/generate-props-tables.mjs` on every `codegen`. Committed, they would be a second copy of
# the types that could disagree with the first (`docs-site.md` §4.2).
apps/docs/src/generated/

# Test artifacts
coverage/
test-results/
playwright-report/
.vitest-attachments/
**/__screenshots__/

# Env
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.localized
__MACOSX/
*.log

# The consumer fixture's Panda output — two throwaway runs over fixture configs that call
# `defineChakraConfig()`, one of them hashed. Each writes its own outdir, its own `chakra-system.ts`
# and its own stylesheet. Regenerated by the `cssgen` Turbo task, never committed.
packages/*/src/**/__fixtures__/**/styled-system-app/
packages/*/src/**/__fixtures__/**/styled-system-hashed/
packages/*/src/**/__fixtures__/**/consumer.css
packages/*/src/**/__fixtures__/**/consumer-hashed.css
.claude/settings.local.json
