{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // The props-table generator reads `packages/components/src/**` — **another package's source**
    // — and Turbo's default input set is the task's own package. That is exactly D-125's shape,
    // and it is silent in both directions: a component gaining a prop would be a cache hit, so the
    // table would keep its previous contents and a reader would conclude the prop does not exist;
    // a component losing one would keep the row. **This glob must stay in step with the directory
    // `scripts/generate-props-tables.mjs` walks.**
    "codegen": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/generate-props-tables.mjs",
        "$TURBO_ROOT$/packages/components/src/**"
      ],
      "outputs": ["src/generated/**"]
    },
    // The same coupling, for the same reason, on the Panda run. `panda.config.ts#include` names
    // two things: this app's own source (covered by `$TURBO_DEFAULT$`) and
    // `@chakra-ui-solid/components`' **buildinfo**, which lives in another package's `dist`. The
    // buildinfo is how values our components name — recipe variants above all — reach a consumer's
    // extractor at all, so a stale cache here is a page rendering unstyled with a green build.
    //
    // It matches nothing until step 4, when `components` first emits one. Declared now so the
    // coupling arrives with the file rather than after the first silent miss.
    "cssgen": {
      "dependsOn": ["codegen", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/components/dist/panda.buildinfo.json",
        "$TURBO_ROOT$/packages/preset/dist/**"
      ],
      "outputs": ["styled-system/**"]
    },
    // The build imports `styled-system/styles.css?url`, so the sheet has to exist first — and
    // `^build` is what makes `@chakra-ui-solid/*` resolve through `exports` → `dist` under the
    // `"solid"` condition rather than through a `src` alias, which is the whole point of the docs
    // app being a consumer (`docs-site.md` §1.3).
    "build": {
      "dependsOn": ["cssgen", "^build"],
      "outputs": ["dist/**", ".output/**", ".tanstack/**"]
    },
    "typecheck": {
      "dependsOn": ["codegen", "^build"],
      "outputs": []
    }
  }
}
