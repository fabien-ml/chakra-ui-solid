{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // The props-table generator reads `packages/chakra-ui-solid/src/components/**` — **another package's source**
    // — and Turbo's default input set is the task's own package. That is exactly D-125's shape,
    // and it is silent in both directions: a component gaining a prop would be a cache hit, so the
    // table would keep its previous contents and a reader would conclude the prop does not exist;
    // a component losing one would keep the row. **This glob must stay in step with the directory
    // `scripts/generate-props-tables.mjs` walks.**
    //
    // `src/routeTree.gen.ts` is the other generated file, TanStack Router's, written from
    // `src/routes/` by `scripts/generate-route-tree.mjs` — those routes are this package's own
    // source, so `$TURBO_DEFAULT$` already covers them. It is named in `outputs` for the reason
    // above read the other way: a cache hit restores the declared outputs and runs nothing, so a
    // file this task writes but does not name is simply absent afterwards. `typecheck` reads it,
    // and its absence is what put `Cannot find module './routeTree.gen'` in CI to begin with.
    "codegen": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/generate-props-tables.mjs",
        "$TURBO_ROOT$/scripts/generate-route-tree.mjs",
        "$TURBO_ROOT$/packages/chakra-ui-solid/src/components/**"
      ],
      "outputs": ["src/generated/**", "src/routeTree.gen.ts"]
    },
    // The same coupling, for the same reason, on the Panda run. `panda.config.ts#include` names
    // two things: this app's own source (covered by `$TURBO_DEFAULT$`) and
    // `chakra-ui-solid/dist/panda.buildinfo.json`, which is another package's build output —
    // `scripts/ship-buildinfo.mjs` writes it from that package's `build`. It is how values our
    // components name and no consumer's source spells — a style config handed to `chakra()` —
    // reach a consumer's extractor at all, so a stale cache here is a page rendering unstyled with
    // a green build.
    "cssgen": {
      "dependsOn": ["codegen", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/chakra-ui-solid/dist/**",
        "$TURBO_ROOT$/packages/panda-preset/dist/**"
      ],
      "outputs": ["styled-system/**"]
    },
    // The build imports `styled-system/styles.css?url`, so the sheet has to exist first — and
    // `^build` is what makes `@chakra-ui-solid/*` resolve through `exports` → `dist` under the
    // `"solid"` condition rather than through a `src` alias, which is the whole point of the docs
    // app being a consumer (`docs-site.md` §1.3).
    "build": {
      "dependsOn": ["cssgen", "^build"],
      "outputs": ["dist/**", ".output/**", ".tanstack/**"]
    },
    "typecheck": {
      "dependsOn": ["codegen", "^build"],
      "outputs": []
    }
  }
}
