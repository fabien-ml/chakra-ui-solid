{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "packages/**/*.ts",
      "packages/**/*.tsx",
      "apps/**/*.ts",
      "apps/**/*.tsx",
      ".storybook/**/*.ts",
      "scripts/**/*.mjs",
      "*.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useBlockStatements": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      // `src/zag/` is the forked `@zag-js/solid` adapter, and its `any`s are upstream's: the
      // normalizer is declared over `JSX.HTMLAttributes<any>` because it accepts every element's
      // props, and `createTrack` takes `any[]` because a machine's dependency list is whatever that
      // machine tracks. Retyping them would diverge this directory from the file it is re-synced
      // against (`zag-solid-adapter.md` §1) in a way that says nothing about our code — the diff is
      // the point of the fork. Its tests sit here too, and they pass deliberately invalid shapes to
      // prove the normalizer drops them.
      //
      // This file is `.jsonc` for these comments: Biome parses a `biome.json` as strict JSON, and a
      // comment in one fails with `Found a nested root configuration`, naming a gitignored path in
      // `__reference-impl__` rather than the line it choked on.
      "includes": ["**/src/zag/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      // `src/chakra/` is the vendored `@chakra-ui/panda-preset`, and the same argument applies: a
      // Chakra bump is meant to be a `diff -r` against that tree, so a rule fixed here shows up as
      // our change in every future diff and says nothing about our code. Three `any`s in a utility
      // transform, one guard clause and one string concatenation, all in `utilities.ts` — the one
      // file there with statements in it rather than a token table.
      "includes": ["**/src/chakra/**"],
      "linter": {
        "rules": {
          "style": {
            "useBlockStatements": "off",
            "useTemplate": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.browser.test.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementToInteractiveRole": "off",
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "useAriaActivedescendantWithTabindex": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    }
  ]
}
