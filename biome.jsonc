{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "packages/**/*.ts",
      "packages/**/*.tsx",
      "apps/**/*.ts",
      "apps/**/*.tsx",
      ".storybook/**/*.ts",
      "scripts/**/*.mjs",
      "*.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useBlockStatements": "error"
        // `style/noMagicNumbers` was tried on 2026-08-20 and rejected: it flags the operands of any
        // arithmetic, including inside the named `const` it tells you to extract — `const
        // DEFAULT_RATIO = 4 / 3` and `maxBuffer: 64 * 1024 * 1024` both fail — and Biome 2.5.7
        // gives the rule no options (ESLint's `ignore` array has no equivalent). A rule whose only
        // satisfying answer is a `biome-ignore` teaches suppression, so the style review keeps this.
      },
      "complexity": {
        // `const x = function x()` names the same thing twice. The rule does not reach a
        // top-level `function foo()` declaration — that half stays the style review's work.
        "useArrowFunction": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      // `src/zag/` is the forked `@zag-js/solid` adapter, and its `any`s are upstream's: the
      // normalizer is declared over `JSX.HTMLAttributes<any>` because it accepts every element's
      // props, and `createTrack` takes `any[]` because a machine's dependency list is whatever that
      // machine tracks. Retyping them would diverge this directory from the file it is re-synced
      // against (`zag-solid-adapter.md` §1) in a way that says nothing about our code — the diff is
      // the point of the fork. Its tests sit here too, and they pass deliberately invalid shapes to
      // prove the normalizer drops them.
      //
      // This file is `.jsonc` for these comments: Biome parses a `biome.json` as strict JSON, and a
      // comment in one fails with `Found a nested root configuration`, naming a gitignored path in
      // `__reference-impl__` rather than the line it choked on.
      "includes": ["**/src/zag/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      // Browser tests deliberately build markup a component would never ship: an element carrying a
      // role its tag does not imply, a `<button>` with no `type`. That is the defect under test, and
      // the a11y lint would reject the test instead of the bug.
      "includes": ["**/*.browser.test.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementToInteractiveRole": "off",
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "useAriaActivedescendantWithTabindex": "off",
            "useKeyWithClickEvents": "off",
            "useButtonType": "off"
          }
        }
      }
    }
  ]
}
