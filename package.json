{
  "name": "@chakra-ui-solid/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Chakra UI v3's component API for SolidJS 2.0 — Zag.js behavior, Panda CSS styling, no runtime CSS-in-JS",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks || true; turbo run codegen",
    "build": "turbo run build",
    "codegen": "turbo run codegen",
    "cssgen": "turbo run cssgen",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm cssgen && vitest run",
    "test:unit": "pnpm cssgen && vitest run --project=unit",
    "test:ssr": "pnpm cssgen && vitest run --project=ssr",
    "test:browser": "pnpm cssgen && vitest run --project=browser",
    "storybook": "pnpm cssgen && storybook dev -p 6006 --disable-telemetry",
    "dev:docs": "pnpm cssgen && pnpm --filter @chakra-ui-solid/docs dev",
    "build:docs": "turbo run build --filter=@chakra-ui-solid/docs",
    "preview:docs": "pnpm --filter @chakra-ui-solid/docs preview",
    "check:no-runtime-css": "node scripts/check-no-runtime-css.mjs",
    "check:attribution": "node scripts/check-attribution.mjs",
    "check:declaration-support": "node scripts/check-declaration-support.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter='./packages/*' && changeset publish"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@changesets/cli": "2.31.1",
    "@playwright/test": "1.62.1",
    "@solidjs/web": "catalog:",
    "@types/node": "26.2.0",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@zag-js/focus-visible": "catalog:",
    "babel-preset-solid": "catalog:",
    "oxc-parser": "0.143.0",
    "playwright": "1.62.1",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "tsdown": "^0.22.14",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vite-plugin-solid": "catalog:",
    "vitest": "4.1.10"
  }
}
