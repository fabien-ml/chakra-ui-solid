{
  "name": "chakra-ui-solid",
  "version": "0.0.0",
  "private": true,
  "description": "Chakra UI v3's component API for SolidJS 2.0 — Zag.js behavior, Panda CSS styling, no runtime CSS-in-JS",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "postinstall": "turbo run codegen",
    "build": "turbo run build",
    "codegen": "turbo run codegen",
    "cssgen": "turbo run cssgen",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:unit": "pnpm codegen && vitest run --project=unit",
    "test:ssr": "pnpm cssgen && vitest run --project=ssr",
    "test:browser": "pnpm cssgen && vitest run --project=browser",
    "storybook": "pnpm cssgen && storybook dev -p 6006 --disable-telemetry",
    "dev:docs": "pnpm cssgen && pnpm --filter @chakra-ui-solid/docs dev",
    "build:docs": "turbo run build --filter=@chakra-ui-solid/docs",
    "preview:docs": "pnpm --filter @chakra-ui-solid/docs preview",
    "check:test-projects": "node scripts/check-test-projects.mjs",
    "check:resolution-sync": "node scripts/check-resolution-sync.mjs",
    "check:commit-trailers": "node scripts/check-commit-trailers.mjs",
    "check:doc-index": "node scripts/check-doc-index.mjs",
    "check:skill-pointers": "node scripts/check-skill-pointers.mjs",
    "check:context-budget": "node scripts/check-context-budget.mjs",
    "docs:index": "node scripts/build-doc-index.mjs",
    "check:no-cij-manifest": "node scripts/check-no-cij-manifest.mjs",
    "check:no-runtime-sheet": "node scripts/check-no-runtime-sheet.mjs",
    "check:style-contract": "node scripts/check-style-contract.mjs",
    "check:docs-consumer-config": "node scripts/check-docs-consumer-config.mjs",
    "check:docs-inventory": "node scripts/check-docs-inventory.mjs",
    "check:docs-examples": "node scripts/check-docs-examples.mjs",
    "check:alias-coverage": "node scripts/check-alias-coverage.mjs",
    "check:preflight-hidden": "node scripts/check-preflight-hidden.mjs",
    "check:dark-selector": "node scripts/check-dark-selector.mjs",
    "check:preset-token-resolution": "node scripts/check-preset-token-resolution.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:externals": "node scripts/check-externals.mjs",
    "check:peer-panda": "node scripts/check-peer-panda.mjs",
    "check:license-headers": "node scripts/check-license-headers.mjs",
    "check:notice-rows": "node scripts/check-notice-rows.mjs",
    "check:package-files": "node scripts/check-package-files.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter='./packages/*' && changeset publish"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@changesets/cli": "2.31.1",
    "@playwright/test": "1.62.1",
    "@solidjs/web": "catalog:",
    "@types/node": "26.2.0",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@zag-js/focus-visible": "catalog:",
    "babel-preset-solid": "catalog:",
    "oxc-parser": "0.143.0",
    "playwright": "1.62.1",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "tsdown": "^0.22.14",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vite-plugin-solid": "catalog:",
    "vitest": "4.1.10"
  }
}
