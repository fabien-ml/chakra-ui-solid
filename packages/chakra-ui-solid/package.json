{
  "name": "chakra-ui-solid",
  "version": "0.0.0",
  "description": "Chakra UI v3's component API for SolidJS 2.0 \u2014 Zag.js behavior, Panda CSS styling, no runtime CSS-in-JS",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md"
  ],
  "chakraUiSolid": {
    "entries": {
      ".": "src/components/index.ts",
      "absolute-center": "src/components/absolute-center/index.ts",
      "aspect-ratio": "src/components/aspect-ratio/index.ts",
      "badge": "src/components/badge/index.ts",
      "bleed": "src/components/bleed/index.ts",
      "box": "src/components/box/index.ts",
      "button": "src/components/button/index.ts",
      "center": "src/components/center/index.ts",
      "checkmark": "src/components/checkmark/index.ts",
      "circle": "src/components/circle/index.ts",
      "code": "src/components/code/index.ts",
      "collapsible": "src/components/collapsible/index.ts",
      "color-swatch": "src/components/color-swatch/index.ts",
      "container": "src/components/container/index.ts",
      "dialog": "src/components/dialog/index.ts",
      "em": "src/components/em/index.ts",
      "environment": "src/components/environment/index.ts",
      "field": "src/components/field/index.ts",
      "flex": "src/components/flex/index.ts",
      "float": "src/components/float/index.ts",
      "grid": "src/components/grid/index.ts",
      "group": "src/components/group/index.ts",
      "heading": "src/components/heading/index.ts",
      "icon": "src/components/icon/index.ts",
      "input": "src/components/input/index.ts",
      "kbd": "src/components/kbd/index.ts",
      "link": "src/components/link/index.ts",
      "loader": "src/components/loader/index.ts",
      "locale": "src/components/locale/index.ts",
      "mark": "src/components/mark/index.ts",
      "popover": "src/components/popover/index.ts",
      "quote": "src/components/quote/index.ts",
      "radiomark": "src/components/radiomark/index.ts",
      "separator": "src/components/separator/index.ts",
      "simple-grid": "src/components/simple-grid/index.ts",
      "skeleton": "src/components/skeleton/index.ts",
      "skip-nav": "src/components/skip-nav/index.ts",
      "spacer": "src/components/spacer/index.ts",
      "span": "src/components/span/index.ts",
      "spinner": "src/components/spinner/index.ts",
      "square": "src/components/square/index.ts",
      "stack": "src/components/stack/index.ts",
      "sticky": "src/components/sticky/index.ts",
      "strong": "src/components/strong/index.ts",
      "text": "src/components/text/index.ts",
      "visually-hidden": "src/components/visually-hidden/index.ts",
      "wrap": "src/components/wrap/index.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "solid": "./dist/*/index.jsx"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "cssgen": "panda cssgen --cwd src/components/box/__tests__/__fixtures__/consumer --outfile src/components/box/__tests__/__fixtures__/consumer/consumer.css"
  },
  "peerDependencies": {
    "@pandacss/dev": "catalog:",
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:"
  },
  "dependencies": {
    "@chakra-ui-solid/core": "workspace:*",
    "@chakra-ui-solid/styled-system": "workspace:*",
    "@zag-js/collapsible": "catalog:",
    "@zag-js/dialog": "catalog:",
    "@zag-js/popover": "catalog:"
  },
  "devDependencies": {
    "@chakra-ui-solid/internal-test-utils": "workspace:*",
    "@chakra-ui-solid/panda-preset": "workspace:*",
    "@pandacss/dev": "catalog:",
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:",
    "tsdown": "^0.22.14"
  }
}
