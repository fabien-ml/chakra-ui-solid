{
  "name": "@chakra-ui-solid/components",
  "version": "0.0.0",
  "description": "Chakra UI v3's component API for SolidJS 2.0 \u2014 Zag.js behavior, Panda CSS styling, no runtime CSS-in-JS",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md"
  ],
  "chakraUiSolid": {
    "entries": {
      ".": "src/index.ts",
      "absolute-center": "src/absolute-center/index.ts",
      "aspect-ratio": "src/aspect-ratio/index.ts",
      "bleed": "src/bleed/index.ts",
      "box": "src/box/index.ts",
      "center": "src/center/index.ts",
      "circle": "src/circle/index.ts",
      "container": "src/container/index.ts",
      "em": "src/em/index.ts",
      "environment": "src/environment/index.ts",
      "flex": "src/flex/index.ts",
      "float": "src/float/index.ts",
      "grid": "src/grid/index.ts",
      "group": "src/group/index.ts",
      "locale": "src/locale/index.ts",
      "quote": "src/quote/index.ts",
      "simple-grid": "src/simple-grid/index.ts",
      "spacer": "src/spacer/index.ts",
      "span": "src/span/index.ts",
      "square": "src/square/index.ts",
      "stack": "src/stack/index.ts",
      "sticky": "src/sticky/index.ts",
      "strong": "src/strong/index.ts",
      "visually-hidden": "src/visually-hidden/index.ts",
      "wrap": "src/wrap/index.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "solid": "./dist/*/index.jsx"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "cssgen": "panda cssgen --cwd src/box/__tests__/__fixtures__/consumer --outfile src/box/__tests__/__fixtures__/consumer/consumer.css"
  },
  "peerDependencies": {
    "@pandacss/dev": "catalog:",
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:"
  },
  "dependencies": {
    "@chakra-ui-solid/styled-system": "workspace:*",
    "@chakra-ui-solid/system": "workspace:*"
  },
  "devDependencies": {
    "@chakra-ui-solid/internal-test-utils": "workspace:*",
    "@chakra-ui-solid/panda-preset": "workspace:*",
    "@pandacss/dev": "catalog:",
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:",
    "tsdown": "^0.22.14"
  }
}
