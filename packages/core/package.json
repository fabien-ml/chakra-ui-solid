{
  "name": "@chakra-ui-solid/core",
  "version": "0.0.0",
  "description": "The styling and rendering kernel — renderStyled, the render prop and `as` polymorphism, the recipe layer, and the locale and environment contexts",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "LICENSE", "NOTICE.md"],
  "chakraUiSolid": {
    "entries": {
      ".": "src/index.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:"
  },
  "dependencies": {
    "@chakra-ui-solid/styled-system": "workspace:*",
    "@zag-js/dom-query": "catalog:",
    "@zag-js/i18n-utils": "catalog:"
  },
  "devDependencies": {
    "@chakra-ui-solid/internal-test-utils": "workspace:*",
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:",
    "tsdown": "^0.22.14"
  }
}
