{
  "name": "@chakra-ui-solid/preset",
  "version": "0.0.0",
  "description": "The Panda CSS preset for chakra-ui-solid — Chakra v3's design system plus the staticCss declarations that make internally-emitted recipe variants reach a consumer's stylesheet",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "LICENSE", "NOTICE.md"],
  "chakraUiSolid": {
    "entries": {
      ".": "src/index.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@pandacss/dev": "catalog:"
  },
  "dependencies": {
    "@chakra-ui/panda-preset": "catalog:",
    "@pandacss/preset-base": "catalog:"
  },
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "tsdown": "^0.22.14"
  }
}
