{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declarationMap": false
  },
  // No `src`: this package's source *is* Panda's output, and `styled-system/` is gitignored and
  // regenerated by `codegen`. Type-checking it is type-checking a generated artifact against the
  // config that produced it, which is the one thing here that can actually be wrong.
  "include": ["panda.config.ts", "styled-system"]
}
