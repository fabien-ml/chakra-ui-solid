{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "tsdown.config.base.ts",
    "solid-babel-options.ts",
    "vitest.config.ts",
    "vitest-aliases.ts",
    "vitest-projects.ts",
    "vitest-hydration-bridge.ts",
    "attribution.config.ts",
    "pnpm-workspace.yaml"
  ],
  "tasks": {
    // `@chakra-ui-solid/styled-system` is *generated* by Panda, so it must exist before anything
    // reads it — type-checking included, which otherwise fails with hundreds of unrelated errors
    // (`plan.md` §9).
    //
    // `^build` reaches exactly one package in practice, `@chakra-ui-solid/panda-preset`: Panda's
    // config loader resolves it through its `exports` map rather than through
    // `tsconfig.base.json#paths`, so the *published* shape is the shape codegen reads.
    "codegen": {
      "dependsOn": ["^build"],
      "outputs": ["styled-system/**"]
    },
    // Two stylesheets, from two Panda runs. `styled-system`'s is **ours** — the dev sheet the
    // browser tests and `check:css-coverage` assert against. `components`' is a **consumer's**,
    // generated from a fixture config that spreads `chakraConfig()`, and it is what proves an
    // override in their config changes what our components render.
    //
    // The dev sheet is NOT published, and that holds by task ordering rather than by any check.
    // Measured at S4: `@chakra-ui-solid/styled-system` declares `files: ["styled-system", …]`, so
    // after a `cssgen` run `npm pack` puts `styled-system/styles.css` (319 KB) in the tarball —
    // `check:no-runtime-css` tests `files` entries for a `.css` *suffix* and a directory is not one. The
    // release path escapes it only because `codegen` runs `panda codegen --clean`, which deletes
    // the sheet, and `build` depends on `codegen` and never on `cssgen`. Publishing from a working
    // tree where anyone ran `pnpm cssgen` ships the CSS this library promises never to ship, with
    // a green build (`CLAUDE.md` §0; `plan.md` §4.4; DoD §8 row S4-A).
    //
    // `^codegen` is what makes the consumer fixture wait for the generated artifacts, and reaches
    // the preset's build through them.
    //
    // `inputs` has to name the source Panda *scans*, which is not the package the task runs in:
    // `packages/styled-system/panda.config.ts#include` reads `../{system,components}/src`, and
    // Turbo's default input set is the task's own package. Without these two lines a style prop
    // added anywhere in the library is a cache hit — `pnpm cssgen` prints FULL TURBO, the dev
    // stylesheet keeps its previous contents, and the new class has no rule. Both directions are
    // silent: a new value renders unstyled, and a deleted one keeps its rule and its passing test.
    // **These globs must stay in step with that `include`.**
    "cssgen": {
      "dependsOn": ["codegen", "^codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/system/src/**",
        "$TURBO_ROOT$/packages/components/src/**"
      ],
      "outputs": ["styled-system/styles.css", "src/**/__fixtures__/**/consumer.css"]
    },
    // `^codegen` is what makes `system` and `components` wait for `styled-system`. Their own
    // `codegen` does not exist, and `^build` does not reach it either, because `styled-system` has
    // no `build` — its build IS its codegen. Without this edge a fresh `turbo run build` compiles
    // against generated files that are not there yet.
    "build": {
      "dependsOn": ["codegen", "^codegen", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/*.ssr.test.ts",
        "!src/**/*.ssr.test.tsx",
        "!src/**/*.browser.test.ts",
        "!src/**/*.browser.test.tsx",
        "!src/**/*.stories.ts",
        "!src/**/*.stories.tsx",
        "!src/**/*.md",
        "!src/**/__fixtures__/**"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["codegen", "^codegen"],
      "outputs": []
    },
    // The three Vitest projects run from ONE root config, so today these are ordering
    // declarations rather than live tasks — nothing resolves them until a package owns a
    // `test:*` script. Until then the root `test:*` scripts run `pnpm cssgen` ahead of the suite,
    // which is the same ordering by a different route.
    //
    // `unit` needs the stylesheet as well as the codegen artifacts: the preset's generated-CSS
    // tests read what Panda emitted.
    "test:unit": {
      "dependsOn": ["cssgen"],
      "outputs": []
    },
    // `ssr` and `browser` need the **stylesheet**, not only the codegen artifacts: with no DOM the
    // `ssr` project resolves a class through the generated sheet, and the `browser` project injects
    // the same file into the test page so `getComputedStyle` has a cascade to read.
    "test:ssr": {
      "dependsOn": ["cssgen"],
      "outputs": []
    },
    "test:browser": {
      "dependsOn": ["cssgen"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
